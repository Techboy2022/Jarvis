# Copy to .env and edit. Every value is optional.

# Bind address. Use 0.0.0.0 to reach JARVIS from other devices on your LAN.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8080

# Where Ollama lives.
OLLAMA_URL=http://127.0.0.1:11434

# Default model. Good CPU-only picks for a T490:
#   qwen3:4b            balanced, reasoning
#   llama3.2:3b         fastest usable general model
#   qwen2.5-coder:3b    code
#   phi4-mini           strong for its size
JARVIS_MODEL=qwen3:4b

# Generation defaults (also editable in the UI).
JARVIS_TEMPERATURE=0.7
JARVIS_TOP_P=0.9
JARVIS_NUM_CTX=4096
JARVIS_NUM_PREDICT=1024
# Physical cores, not threads. T490 (i5-8265U / i7-8565U) = 4.
JARVIS_NUM_THREAD=4
# Keep the model resident so follow-up questions skip the ~15 s reload.
JARVIS_KEEP_ALIVE=30m
# How many past messages are replayed to the model each turn.
JARVIS_HISTORY_LIMIT=20

# SQLite file holding all conversations.
JARVIS_DB=~/.local/share/jarvis/jarvis.db

# System prompt (the UI overrides this once you save settings).
# JARVIS_SYSTEM_PROMPT=You are JARVIS...
